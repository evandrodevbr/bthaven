<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BTHaven_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BTHaven_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,24" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DetailRows" TargetType="Grid">
            <Setter Property="RowSpacing" Value="12" />
            <Setter Property="ColumnSpacing" Value="20" />
        </Style>
    </Page.Resources>

    <Grid x:Name="WorkspaceRoot"
          Padding="24,16,24,24"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates"
                              CurrentStateChanged="LayoutStates_CurrentStateChanged">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DevicePane.Visibility" Value="Visible" />
                        <Setter Target="SelectedDevicePane.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceRoot.Padding" Value="18,16,18,20" />
                        <Setter Target="WorkspaceRoot.RowSpacing" Value="12" />
                        <Setter Target="ProductHeader.ColumnSpacing" Value="0" />
                        <Setter Target="GlobalCommandBar.(Grid.Row)" Value="1" />
                        <Setter Target="GlobalCommandBar.(Grid.Column)" Value="0" />
                        <Setter Target="GlobalCommandBar.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GlobalCommandBar.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DevicePaneColumn.Width" Value="360" />
                        <Setter Target="MasterDetailRegion.ColumnSpacing" Value="12" />
                        <Setter Target="DevicePane.Visibility" Value="Visible" />
                        <Setter Target="SelectedDevicePane.Visibility" Value="Visible" />
                        <Setter Target="DevicePaneHeader.Padding" Value="14,14,14,6" />
                        <Setter Target="DeviceFilterHeader.Padding" Value="8,0,6,8" />
                        <Setter Target="DeviceList.Margin" Value="4,0,4,4" />
                        <Setter Target="SelectedDeviceHeader.Padding" Value="18,16,18,6" />
                        <Setter Target="DetailSelectorBar.Margin" Value="10,0,10,4" />
                        <Setter Target="SummaryContent.Padding" Value="18,8,18,20" />
                        <Setter Target="AudioContent.Padding" Value="18,8,18,20" />
                        <Setter Target="DiagnosticsContent.Padding" Value="18,8,18,20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceRoot.Padding" Value="12,12,12,16" />
                        <Setter Target="WorkspaceRoot.RowSpacing" Value="10" />
                        <Setter Target="ProductHeader.ColumnSpacing" Value="0" />
                        <Setter Target="GlobalCommandBar.(Grid.Row)" Value="1" />
                        <Setter Target="GlobalCommandBar.(Grid.Column)" Value="0" />
                        <Setter Target="GlobalCommandBar.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GlobalCommandBar.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DevicePaneColumn.Width" Value="*" />
                        <Setter Target="DetailPaneColumn.Width" Value="0" />
                        <Setter Target="MasterDetailRegion.ColumnSpacing" Value="0" />
                        <Setter Target="DevicePane.Visibility" Value="Visible" />
                        <Setter Target="SelectedDevicePane.Visibility" Value="Collapsed" />
                        <Setter Target="SelectedDevicePane.(Grid.Column)" Value="0" />
                        <Setter Target="CompactBackButton.Visibility" Value="Visible" />
                        <Setter Target="DevicePaneHeader.Padding" Value="14,14,14,6" />
                        <Setter Target="DeviceFilterHeader.Padding" Value="8,0,6,8" />
                        <Setter Target="DeviceList.Margin" Value="4,0,4,4" />
                        <Setter Target="SelectedDeviceHeader.Padding" Value="16,14,16,6" />
                        <Setter Target="DetailSelectorBar.Margin" Value="8,0,8,4" />
                        <Setter Target="SummaryContent.Padding" Value="16,8,16,20" />
                        <Setter Target="AudioContent.Padding" Value="16,8,16,20" />
                        <Setter Target="DiagnosticsContent.Padding" Value="16,8,16,20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ProductHeader"
              Grid.Row="0"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.scale-200.png"
                       Width="48" Height="48" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Bluetooth Hub"
                               Style="{StaticResource TitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Dispositivos, bateria e áudio em um só lugar."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <CommandBar x:Name="GlobalCommandBar"
                        Grid.Column="1"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        Background="Transparent">
                <AppBarButton x:Name="LogsButton"
                              Label="Logs"
                              Click="LogsButton_Click"
                              AutomationProperties.Name="Abrir logs">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DiagnosticsButton"
                              Label="Diagnósticos"
                              Click="DiagnosticsButton_Click"
                              AutomationProperties.Name="Abrir diagnósticos">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Message="Aguardando enumeração dos dispositivos emparelhados..."
                 AutomationProperties.LiveSetting="Polite" />

        <Grid x:Name="MasterDetailRegion"
              Grid.Row="2"
              ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DevicePaneColumn" Width="360" />
                <ColumnDefinition x:Name="DetailPaneColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DevicePane"
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid x:Name="DevicePaneHeader"
                      Padding="20,20,20,12"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Dispositivos"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="DeviceCountText"
                                   Grid.Column="1"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="DeviceFilterHeader"
                          Grid.Row="1"
                      Padding="16,0,16,16"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <ComboBox x:Name="FilterComboBox"
                                  Header="Filtrar dispositivos"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FilterComboBox_SelectionChanged"
                                  AutomationProperties.Name="Filtrar dispositivos Bluetooth">
                            <ComboBoxItem Content="Todos" Tag="All" />
                            <ComboBoxItem Content="Conectados" Tag="Connected" />
                            <ComboBoxItem Content="Emparelhados" Tag="Paired" />
                            <ComboBoxItem Content="Bluetooth LE" Tag="Ble" />
                            <ComboBoxItem Content="Bluetooth Classic" Tag="Classic" />
                            <ComboBoxItem Content="Áudio" Tag="Audio" />
                            <ComboBoxItem Content="Smartphones" Tag="Smartphones" />
                            <ComboBoxItem Content="Periféricos" Tag="Peripherals" />
                        </ComboBox>
                        <AppBarButton x:Name="RefreshButton"
                                  ToolTipService.ToolTip="Atualizar dispositivos (F5)"
                                      Grid.Column="1"
                                      Icon="Refresh"
                                      Label="Atualizar"
                                      Click="RefreshButton_Click"
                                      VerticalAlignment="Bottom"
                                      AutomationProperties.Name="Atualizar dispositivos Bluetooth">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="DeviceList"
                          Margin="8,0,8,8"
                                  SelectionMode="Single"
                                  SelectionChanged="DeviceList_SelectionChanged"
                                  AutomationProperties.Name="Dispositivos Bluetooth">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                            <Grid Padding="12"
                                  ColumnDefinitions="40,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="10"
                                  AutomationProperties.Name="{Binding TelemetryAutomationText}">
                                <Border Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="20" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTipService.ToolTip="{Binding BatteryText}" />
                                        <TextBlock Text="{Binding TelemetryText}" Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTipService.ToolTip="{Binding TelemetryText}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Tag="{Binding}"
                                                  IsOn="{Binding MediaEnabled}"
                                                  IsEnabled="{Binding MediaToggleEnabled}"
                                                  Toggled="MediaToggleSwitch_Toggled"
                                                  OnContent="Áudio ativo" OffContent="Áudio"
                                                  AutomationProperties.Name="{Binding MediaAutomationName}" />
                                </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState"
                                    Margin="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="14"
                                    MaxWidth="270">
                            <FontIcon Glyph="&#xE702;" FontSize="34" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Text="Nenhum dispositivo corresponde ao filtro atual."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Opacity="0.72"
                                       AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Text="Emparelhe um dispositivo no Windows ou escolha outro filtro."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SelectedDevicePane"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel x:Name="SelectedDeviceHeader"
                            Padding="24,24,24,16"
                            Spacing="12">
                        <Button x:Name="CompactBackButton"
                                Visibility="Collapsed"
                                Click="CompactBackButton_Click"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Voltar à lista de dispositivos">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator x:Name="CompactBackAccelerator" Key="Escape" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="Voltar" />
                            </StackPanel>
                        </Button>
                        <ContentControl x:Name="SelectedDeviceHeading"
                                        IsTabStop="True"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Text, ElementName=SelectedDeviceName}"
                                        AutomationProperties.HeadingLevel="Level2">
                            <TextBlock x:Name="SelectedDeviceName"
                                       Text="Selecione um dispositivo"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </ContentControl>
                        <TextBlock x:Name="SelectedDeviceSubtitle"
                                   Text="Escolha um dispositivo na lista para consultar seus detalhes e controles de áudio."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Grid x:Name="SelectedDeviceStatus" Visibility="Collapsed" ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="8">
                            <TextBlock Text="Estado"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionStateText"
                                       Grid.Column="1"
                                       Text="—"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Text="Endpoint preferido"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionTransportText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <SelectorBar x:Name="DetailSelectorBar"
                                 Grid.Row="1"
                                 Visibility="Collapsed"
                             Margin="16,0,16,0"
                                 SelectionChanged="DetailSelectorBar_SelectionChanged"
                                 AutomationProperties.Name="Informações do dispositivo selecionado">
                        <SelectorBarItem x:Name="SummarySelectorItem" Text="Resumo" />
                        <SelectorBarItem x:Name="AudioSelectorItem" Text="Áudio" />
                        <SelectorBarItem x:Name="DiagnosticsSelectorItem" Text="Diagnóstico" />
                    </SelectorBar>

                    <StackPanel x:Name="SelectionEmptyState" Grid.Row="2"
                                MaxWidth="360" Margin="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="16">
                        <FontIcon Glyph="&#xE702;" FontSize="40"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Seu Bluetooth, organizado"
                                   FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Selecione um dispositivo para ver a conexão, consultar a bateria e acessar os controles disponíveis."
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid x:Name="DeviceDetailContent" Grid.Row="2" Visibility="Collapsed">
                        <ScrollViewer x:Name="SummaryView"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SummaryContent"
                                Padding="24"
                                Spacing="0">
                        <Border Style="{StaticResource SectionDivider}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Conexão" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Style="{StaticResource DetailRows}">
                                    <TextBlock Text="Transporte agregado" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="TransportText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="RSSI" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="RssiText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Observado" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="DeviceObservedText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="Endereço" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="AddressText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Text="ContainerId" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="ContainerIdText" Grid.Row="4" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionDivider}">
                            <StackPanel Spacing="12">

                                <TextBlock Text="Bateria" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Style="{StaticResource DetailRows}">
                                    <TextBlock Text="Estado" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="BatteryText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="Consulta" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="BatteryTelemetryStatusText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Fonte" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="BatterySourceText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="Confiança" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="BatteryConfidenceText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Text="Observação" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="BatteryObservedText" Grid.Row="4" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="12">

                                <TextBlock Text="Capacidades observadas" Style="{StaticResource SectionHeading}" />
                                <TextBlock x:Name="CapabilitiesText" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AudioView"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AudioContent"
                                Padding="24"
                                Spacing="0">
                        <Border Style="{StaticResource SectionDivider}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Áudio de mídia" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="O Windows pode transformar o PC em um destino A2DP usando AudioPlaybackConnection. O telefone precisa enviar a mídia para o PC; o Windows reproduz no endpoint padrão."
                                           TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="A2dpTargetText"
                                           Text="Alvo A2DP: aguardando seleção"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionText}" />
                                <Button x:Name="MediaAudioButton"
                                        Content="Ativar áudio do smartphone"
                                        Click="MediaAudioButton_Click"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <CheckBox x:Name="AutoReconnectCheckBox"
                                          Content="Reconectar áudio automaticamente"
                                          IsChecked="True"
                                          Checked="AutoReconnectCheckBox_Changed"
                                          Unchecked="AutoReconnectCheckBox_Changed" />
                                <ComboBox x:Name="OutputEndpointComboBox"
                                          Header="Endpoint padrão observado"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OutputEndpointComboBox_SelectionChanged" />
                                <TextBlock Text="A AudioPlaybackConnection pública não aceita endpoint arbitrário por conexão. Para ouvir no headset, deixe-o como dispositivo padrão de reprodução do Windows."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionText}" />

                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionDivider}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Volume remoto do smartphone" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="O aplicativo ajusta o volume do telefone somente quando o Windows expõe uma rota oficial de controle AVRCP para este dispositivo."
                                           TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <InfoBar x:Name="RemoteVolumeInfoBar"
                                         IsOpen="True"
                                         Severity="Informational"
                                         Title="Volume remoto aguardando consulta"
                                         Message="Selecione um dispositivo para consultar a capacidade real."
                                         IsClosable="False" />
                                <TextBlock x:Name="RemoteVolumeStatusText"
                                           Text="Volume remoto: aguardando seleção"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionText}" />
                                <Slider x:Name="RemoteVolumeSlider"
                                        Header="Nível solicitado"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.5"
                                        StepFrequency="0.05"
                                        IsEnabled="False" />
                                <Button x:Name="RemoteVolumeButton"
                                        Content="Aplicar volume no smartphone"
                                        Click="RemoteVolumeButton_Click"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="12">

                                <TextBlock Text="Chamadas" Style="{StaticResource SectionHeading}" />
                                <InfoBar x:Name="HfpStatusInfoBar"
                                         IsOpen="True"
                                         Severity="Warning"
                                         Title="HFP aguardando teste"
                                         Message="Selecione um smartphone e use o botão para solicitar o acesso real ao transporte telefônico."
                                         IsClosable="False" />
                                <TextBlock x:Name="HfpTransportText"
                                           Text="Transporte HFP: aguardando seleção"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionText}" />
                                <Button x:Name="HfpEnableButton"
                                        Content="Testar / habilitar chamadas"
                                        Click="HfpEnableButton_Click"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="O Windows pode negar o acesso porque PhoneLineTransportManagement é uma capability restrita. O aplicativo registra a resposta e não simula áudio de chamadas."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionText}" />
                        </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="DiagnosticsView"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DiagnosticsContent"
                                        Padding="24"
                                        Spacing="16">
                                <TextBlock Text="Inspeção detalhada" Style="{StaticResource SectionHeading}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Button x:Name="InspectButton"
                                            Content="Inspecionar tudo"
                                            Click="InspectButton_Click"
                                            IsEnabled="False" />
                                    <TextBlock x:Name="InspectionStatusText"
                                               Grid.Column="1"
                                               Text="Nenhuma inspeção executada"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBox x:Name="InspectionTextBox"
                                         Text="Selecione um dispositivo e execute a inspeção detalhada."
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="280"
                                         FontSize="12"
                                         FontFamily="Cascadia Mono" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
