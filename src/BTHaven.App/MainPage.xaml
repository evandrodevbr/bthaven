<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BTHaven_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1EFFFFFF" />
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,14,24,24" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="3">
                <TextBlock Text="Bluetooth Hub" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Dispositivos locais, estados reais e áudio sem nuvem" Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="FilterComboBox" Width="170" SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Todos" Tag="All" />
                    <ComboBoxItem Content="Conectados" Tag="Connected" />
                    <ComboBoxItem Content="Emparelhados" Tag="Paired" />
                    <ComboBoxItem Content="Bluetooth LE" Tag="Ble" />
                    <ComboBoxItem Content="Bluetooth Classic" Tag="Classic" />
                    <ComboBoxItem Content="Áudio" Tag="Audio" />
                    <ComboBoxItem Content="Smartphones" Tag="Smartphones" />
                    <ComboBoxItem Content="Periféricos" Tag="Peripherals" />
                </ComboBox>
                <Button x:Name="DiagnosticsButton" Content="Diagnósticos" Click="DiagnosticsButton_Click" />
                <Button x:Name="RefreshButton" Content="Atualizar" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="350,*" ColumnSpacing="18">
            <Border Grid.Column="0" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="14,10,14,8" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Dispositivos" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DeviceCountText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="DeviceList" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10" ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BatteryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="250">
                            <FontIcon Glyph="&#xE702;" FontSize="32" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Text="Nenhum dispositivo corresponde ao filtro atual." TextAlignment="Center" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="Emparelhe um dispositivo no Windows e atualize a lista." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SelectedDeviceName" Text="Selecione um dispositivo" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedDeviceSubtitle" Text="A lista usa observações do Windows, não polling agressivo." Opacity="0.72" TextWrapping="Wrap" />
                        <InfoBar x:Name="StatusInfoBar" IsOpen="True" Severity="Informational" Message="Aguardando enumeração dos dispositivos emparelhados..." Margin="0,8,0,8" />

                        <TextBlock Text="Conexão" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                            <TextBlock Text="Estado Bluetooth" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="ConnectionStateText" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="1" Text="Transporte" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="TransportText" Grid.Row="1" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="2" Text="Endereço" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Text="ContainerId" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="ContainerIdText" Grid.Row="3" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock Text="Bateria" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="5">
                            <TextBlock Text="Estado" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="BatteryText" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="1" Text="Fonte" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="BatterySourceText" Grid.Row="1" Grid.Column="1" Text="—" />
                        </Grid>

                        <TextBlock Text="Capacidades observadas" Style="{StaticResource SectionHeading}" />
                        <TextBlock x:Name="CapabilitiesText" Text="—" TextWrapping="Wrap" />

                        <TextBlock Text="Áudio de mídia" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="O Windows expõe o A2DP Sink por AudioPlaybackConnection. A conexão só é aberta quando um alvo compatível for retornado pelo seletor oficial." TextWrapping="Wrap" Opacity="0.72" />
                        <Button x:Name="MediaAudioButton" Content="Ativar áudio do smartphone" Click="MediaAudioButton_Click" IsEnabled="False" HorizontalAlignment="Left" />
                        <ComboBox x:Name="OutputEndpointComboBox" Header="Endpoint de saída" DisplayMemberPath="Name" SelectionChanged="OutputEndpointComboBox_SelectionChanged" />

                        <TextBlock Text="Chamadas" Style="{StaticResource SectionHeading}" />
                        <InfoBar IsOpen="True" Severity="Warning" Title="HFP ainda não habilitado" Message="A API PhoneLineTransportDevice está presente, mas nenhum transporte de telefone foi exposto. O projeto não simula suporte a chamadas." IsClosable="False" />
                        <TextBlock Text="O endpoint de entrada/saída será ativado somente depois de uma prova HFP real com telefone emparelhado e capability/packaging validados." TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
