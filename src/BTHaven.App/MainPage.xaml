<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BTHaven_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1EFFFFFF" />
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,20,28,28" RowDefinitions="Auto,*" RowSpacing="20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="Bluetooth Hub" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Controle local de dispositivos Bluetooth e áudio" Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,8,0">
                <ComboBox x:Name="FilterComboBox" Width="170" SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Todos" Tag="All" />
                    <ComboBoxItem Content="Conectados" Tag="Connected" />
                    <ComboBoxItem Content="Emparelhados" Tag="Paired" />
                    <ComboBoxItem Content="Bluetooth LE" Tag="Ble" />
                    <ComboBoxItem Content="Bluetooth Classic" Tag="Classic" />
                    <ComboBoxItem Content="Áudio" Tag="Audio" />
                    <ComboBoxItem Content="Smartphones" Tag="Smartphones" />
                    <ComboBoxItem Content="Periféricos" Tag="Peripherals" />
                </ComboBox>
                <Button x:Name="LogsButton" Content="Logs" Click="LogsButton_Click" />
                <Button x:Name="DiagnosticsButton" Content="Diagnósticos" Click="DiagnosticsButton_Click" />
                <Button x:Name="RefreshButton" Content="Atualizar" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="18">
            <Border Grid.Column="0" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Dispositivos" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DeviceCountText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="DeviceList" Margin="6,0,6,6" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10" ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BatteryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="270">
                            <FontIcon Glyph="&#xE702;" FontSize="34" HorizontalAlignment="Center" Opacity="0.6" />
                            <TextBlock Text="Nenhum dispositivo corresponde ao filtro atual." TextAlignment="Center" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="Emparelhe um dispositivo no Windows ou escolha outro filtro." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SubtlePanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SelectedDeviceName" Text="Selecione um dispositivo" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedDeviceSubtitle" Text="A lista usa observações do Windows, não polling agressivo." Opacity="0.72" TextWrapping="Wrap" />
                        <InfoBar x:Name="StatusInfoBar" IsOpen="True" Severity="Informational" Message="Aguardando enumeração dos dispositivos emparelhados..." Margin="0,8,0,8" />

                        <TextBlock Text="Conexão" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Text="Estado Bluetooth" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="ConnectionStateText" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="Transporte" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="TransportText" Grid.Row="1" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="2" Text="Endereço" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Text="ContainerId" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="ContainerIdText" Grid.Row="3" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock Text="Bateria" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Text="Estado" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="BatteryText" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="1" Text="Fonte" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="BatterySourceText" Grid.Row="1" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock Text="Capacidades observadas" Style="{StaticResource SectionHeading}" />
                        <TextBlock x:Name="CapabilitiesText" Text="—" TextWrapping="Wrap" />

                        <TextBlock Text="Áudio de mídia" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="O Windows pode transformar o PC em um destino A2DP usando AudioPlaybackConnection. O telefone precisa enviar a mídia para o PC; o Windows reproduz no endpoint padrão." TextWrapping="Wrap" Opacity="0.72" />
                        <TextBlock x:Name="A2dpTargetText" Text="Alvo A2DP: aguardando seleção" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        <Button x:Name="MediaAudioButton" Content="Ativar áudio do smartphone" Click="MediaAudioButton_Click" IsEnabled="False" HorizontalAlignment="Left" />
                        <CheckBox x:Name="AutoReconnectCheckBox" Content="Reconectar áudio automaticamente" IsChecked="True" Checked="AutoReconnectCheckBox_Changed" Unchecked="AutoReconnectCheckBox_Changed" />
                        <ComboBox x:Name="OutputEndpointComboBox" Header="Endpoint padrão observado" DisplayMemberPath="Name" SelectionChanged="OutputEndpointComboBox_SelectionChanged" />
                        <TextBlock Text="A AudioPlaybackConnection pública não aceita endpoint arbitrário por conexão. Para ouvir no headset, deixe-o como dispositivo padrão de reprodução do Windows." TextWrapping="Wrap" Style="{StaticResource CaptionText}" />

                        <TextBlock Text="Chamadas" Style="{StaticResource SectionHeading}" />
                        <InfoBar x:Name="HfpStatusInfoBar" IsOpen="True" Severity="Warning" Title="HFP aguardando teste" Message="Selecione um smartphone e use o botão para solicitar o acesso real ao transporte telefônico." IsClosable="False" />
                        <TextBlock x:Name="HfpTransportText" Text="Transporte HFP: aguardando seleção" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        <Button x:Name="HfpEnableButton" Content="Testar / habilitar chamadas" Click="HfpEnableButton_Click" IsEnabled="False" HorizontalAlignment="Left" />
                        <TextBlock Text="O Windows pode negar o acesso porque phoneLineTransportManagement é uma capability restrita. O aplicativo registra a resposta e não simula áudio de chamadas." TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
